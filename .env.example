# Copy this file to .env.local and fill in your values (used by `npm run dev`).
# For the deployed site, add these as GitHub Actions secrets (Settings → Secrets and variables → Actions):
#   VITE_GOOGLE_CLIENT_ID
#   VITE_SHEETS_WEBHOOK_URL

# Google Cloud Console → OAuth client ID (Web application).
# Authorized JavaScript origins must include https://tensora-structure.github.io
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"

# Google Apps Script web app URL (see google-apps-script/append_login.gs).
VITE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
